{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "public",
  "routes": [
    { "src": "/health", "dest": "/api" },
    { "src": "/mcp", "dest": "/api" },
    { "src": "/grants", "dest": "/api" },
    { "src": "/v1/(.*)", "dest": "/api" },
    { "src": "/", "dest": "/api" },
    { "src": "/(.*)", "dest": "/api" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "dist/**"
    }
  }
}
